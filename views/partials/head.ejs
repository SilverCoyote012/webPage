<!doctype html>
<html lang="es-MX">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} · ${tienda.store_name}` : `${tienda.store_name} · ${tienda.tagline}` %></title>
  <meta name="description" content="<%= locals.description || `${tienda.store_name}: ${tienda.tagline}. Envíos a todo México y pago seguro con tarjeta.` %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tienda.css">
  <script src="/js/tienda.js" defer></script>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<% if (paymentMode === 'demo') { %>
  <div class="demo-bar">Tienda en modo demostración: los pagos son simulados y no se realiza ningún cobro.</div>
<% } %>
<%
  const anuncio = tienda.announcement ||
    (tienda.free_shipping_from_cents > 0 ? `Envío gratis en compras desde ${money(tienda.free_shipping_from_cents).replace('.00', '')}` : 'Envíos a todo México');
%>
<div class="announce"><span class="airmail" aria-hidden="true"></span><%= anuncio %></div>
<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href="/" aria-label="<%= tienda.store_name %>, inicio">
      <span class="logo-mark" aria-hidden="true"></span><%= tienda.store_name %>
    </a>
    <form class="search" action="/productos" method="get" role="search">
      <label class="sr-only" for="buscar">Buscar productos</label>
      <input id="buscar" type="search" name="q" placeholder="Buscar productos…" value="<%= locals.q || '' %>" maxlength="60">
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </form>
    <nav class="main-nav" aria-label="Principal">
      <a href="/productos" <%- path.startsWith('/producto') ? 'aria-current="page"' : '' %>>Productos</a>
      <a href="/ayuda" <%- path === '/ayuda' ? 'aria-current="page"' : '' %>>Ayuda</a>
      <a class="cart-link" href="/carrito" aria-label="Carrito">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 4h2.2l2.3 11h10.2l2-8H7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.6"/><circle cx="17" cy="19.5" r="1.6"/></svg>
        <span>Carrito</span><span class="cart-count" data-cart-count hidden>0</span>
      </a>
    </nav>
  </div>
</header>
<main id="contenido">
