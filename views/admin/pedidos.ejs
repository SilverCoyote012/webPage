<%- include('_inicio') %>
<header class="head"><h1>Pedidos</h1></header>

<nav class="tabs" aria-label="Filtrar por estado">
  <a href="/admin/pedidos" <%- estado ? '' : 'aria-current="page"' %>>Todos</a>
  <% Object.entries(ESTADOS_PEDIDO).forEach(([key, e]) => { %>
    <a href="/admin/pedidos?estado=<%= key %>" <%- estado === key ? 'aria-current="page"' : '' %>><%= e.label %><% if (conteo[key]) { %> <span class="count"><%= conteo[key] %></span><% } %></a>
  <% }) %>
</nav>

<section class="card card-flush">
  <% if (pedidos.length) { %>
  <div class="table-scroll">
    <table class="table">
      <thead><tr><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Destino</th><th>Estado</th><th class="num">Total</th></tr></thead>
      <tbody>
      <% pedidos.forEach((o) => { %>
        <tr>
          <td><a href="/admin/pedidos/<%= o.id %>"><strong><%= numeroPedido(o.id) %></strong></a></td>
          <td class="small"><%= fecha(o.created_at) %></td>
          <td><%= o.customer_name %><br><span class="muted small"><%= o.email %></span></td>
          <td class="small"><%= o.city %>, <%= o.state %></td>
          <td><span class="pill pill-<%= ESTADOS_PEDIDO[o.status].tone %>"><%= ESTADOS_PEDIDO[o.status].label %></span></td>
          <td class="num"><%= money(o.total_cents) %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <p class="muted pad">No hay pedidos<%= estado ? ' con este estado' : ' todavía' %>.</p>
  <% } %>
</section>
<%- include('_fin') %>
