<%- include('_inicio') %>
<header class="head">
  <h1>Productos</h1>
  <a class="btn btn-primary" href="/admin/productos/nuevo">+ Nuevo producto</a>
</header>

<form class="toolbar" method="get" action="/admin/productos">
  <input type="search" name="q" value="<%= q %>" placeholder="Buscar por nombre…" aria-label="Buscar productos">
  <button class="btn" type="submit">Buscar</button>
  <% if (q) { %><a class="more" href="/admin/productos">Quitar filtro</a><% } %>
</form>

<section class="card card-flush">
  <% if (productos.length) { %>
  <div class="table-scroll">
    <table class="table">
      <thead><tr><th></th><th>Producto</th><th>Categoría</th><th class="num">Precio</th><th class="num">Existencias</th><th>Estado</th><th></th></tr></thead>
      <tbody>
      <% productos.forEach((p) => { %>
        <tr>
          <td class="thumb-cell"><img class="thumb" src="<%= p.image || '/img/sin-foto.svg' %>" alt=""></td>
          <td><a href="/admin/productos/<%= p.id %>"><strong><%= p.name %></strong></a><% if (p.featured) { %> <span class="pill pill-info">Destacado</span><% } %><br><span class="muted small"><%= p.origin || 'Sin país de origen' %></span></td>
          <td><%= p.category_name || '—' %></td>
          <td class="num"><%= money(p.price_cents) %></td>
          <td class="num"><% if (p.stock === 0) { %><span class="pill pill-off">Agotado</span><% } else if (p.stock <= 3) { %><span class="pill pill-warn"><%= p.stock %></span><% } else { %><%= p.stock %><% } %></td>
          <td><span class="pill <%= p.active ? 'pill-ok' : 'pill-off' %>"><%= p.active ? 'Visible' : 'Oculto' %></span></td>
          <td class="num"><a class="more" href="/admin/productos/<%= p.id %>">Editar</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <p class="muted pad"><%= q ? 'Ningún producto coincide con la búsqueda.' : 'Aún no hay productos. Crea el primero con el botón de arriba.' %></p>
  <% } %>
</section>
<%- include('_fin') %>
