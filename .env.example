# Copia este archivo como ".env" y completa los valores.

# Puerto y dirección pública del sitio (sin diagonal al final).
PORT=3000
BASE_URL=http://localhost:3000

# En el servidor real usa: NODE_ENV=production
NODE_ENV=development

# Acceso al panel de administración. Solo se usan la PRIMERA vez que arranca
# la tienda (para crear al administrador). Si no pones contraseña se genera
# una al azar y se muestra en la consola.
ADMIN_EMAIL=admin@mitienda.mx
# ADMIN_PASSWORD=

# Stripe (https://dashboard.stripe.com/apikeys).
# Sin estas claves la tienda funciona en MODO DEMOSTRACIÓN (pagos simulados).
# Empieza con las claves de prueba (sk_test_...) y cambia a las reales (sk_live_...) al lanzar.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Carpeta donde se guardan la base de datos y las fotos subidas.
# DATA_DIR=./data

# Pon 1 si el sitio está detrás de un proxy (Railway, Render, Nginx, etc.).
# TRUST_PROXY=1
